{
  "sourceLanguage": "en",
  "strings": {
    "%@ · Undo": {
      "comment": "Below the Inbox after a change: what was done, and the button that takes it back",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ביטול"
          }
        }
      }
    },
    "%lld Unread": {
      "comment": "Above the Inbox: how many conversations are unread",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unread"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unread"
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld לא נקראה"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld לא נקראו"
                }
              }
            }
          }
        }
      }
    },
    "Add a mail account in Goodmail on your iPhone.": {
      "comment": "Shown with no mail accounts",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף חשבון דואר ב‑Goodmail ב‑iPhone."
          }
        }
      }
    },
    "All Caught Up": {
      "comment": "Shown when the Inbox is empty",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין הודעות חדשות"
          }
        }
      }
    },
    "Archive": {
      "comment": "Swipe action: archive",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארכיון"
          }
        }
      }
    },
    "Archived": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועברה לארכיון"
          }
        }
      }
    },
    "Inbox": {
      "comment": "The Inbox screen's title",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דואר נכנס"
          }
        }
      }
    },
    "Marked Read": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומנה כנקראה"
          }
        }
      }
    },
    "Marked Unread": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומנה כלא נקראה"
          }
        }
      }
    },
    "Moved to Inbox": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועברה לדואר נכנס"
          }
        }
      }
    },
    "Moved to Trash": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועברה לפח"
          }
        }
      }
    },
    "No Accounts": {
      "comment": "Shown with no mail accounts",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חשבונות"
          }
        }
      }
    },
    "Nothing in your Inbox.": {
      "comment": "Shown when the Inbox is empty",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיבת הדואר הנכנס ריקה."
          }
        }
      }
    },
    "Open Goodmail on iPhone": {
      "comment": "Shown before the iPhone has sent any mail",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את Goodmail ב‑iPhone"
          }
        }
      }
    },
    "Pinned": {
      "comment": "VoiceOver: a pinned row",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצמדת"
          }
        }
      }
    },
    "Read": {
      "comment": "Swipe action: mark as read",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקראה"
          }
        }
      }
    },
    "Restored": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שוחזרה"
          }
        }
      }
    },
    "Trash": {
      "comment": "Swipe action: move to Trash",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פח"
          }
        }
      }
    },
    "Unpinned": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההצמדה בוטלה"
          }
        }
      }
    },
    "Unread": {
      "comment": "VoiceOver: an unread row",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נקראה"
          }
        }
      }
    },
    "Update Goodmail": {
      "comment": "Shown when the iPhone app is newer than the watch app",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לעדכן את Goodmail"
          }
        }
      }
    },
    "Your iPhone has a newer Goodmail. Update this app to see your mail.": {
      "comment": "Shown when the iPhone app is newer than the watch app",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב‑iPhone יש גרסה חדשה יותר של Goodmail. יש לעדכן את האפליקציה הזו כדי לראות את הדואר."
          }
        }
      }
    },
    "Your mail shows here once the iPhone app has synced.": {
      "comment": "Shown before the iPhone has sent any mail",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדואר יופיע כאן אחרי שהאפליקציה ב‑iPhone תסתנכרן."
          }
        }
      }
    }
  },
  "version": "1.0"
}