{
  "sourceLanguage": "en",
  "strings": {
    "%@ · Undo": {
      "comment": "Below the Inbox after a change: what was done, and the button that takes it back",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ביטול"
          }
        }
      }
    },
    "%lld Unread": {
      "comment": "Above the Inbox: how many conversations are unread",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unread"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Unread"
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld לא נקראה"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld לא נקראו"
                }
              }
            }
          }
        }
      }
    },
    "%lld earlier messages on iPhone": {
      "comment": "Above a long conversation: how many older messages the watch leaves out",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld earlier message on iPhone"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld earlier messages on iPhone"
                }
              }
            }
          }
        },
        "he": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "הודעה קודמת אחת ב-iPhone"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld הודעות קודמות ב-iPhone"
                }
              }
            }
          }
        }
      }
    },
    "Add a mail account in Goodmail on your iPhone.": {
      "comment": "Shown with no mail accounts",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להוסיף חשבון דואר ב‑Goodmail ב‑iPhone."
          }
        }
      }
    },
    "All Caught Up": {
      "comment": "Shown when the Inbox is empty",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין הודעות חדשות"
          }
        }
      }
    },
    "Archive": {
      "comment": "Swipe action: archive",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארכיון"
          }
        }
      }
    },
    "Archived": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועברה לארכיון"
          }
        }
      }
    },
    "Back in Inbox": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזר לדואר הנכנס"
          }
        }
      }
    },
    "Bring your iPhone closer to read this conversation.": {
      "comment": "Shown when the iPhone didn't send a conversation",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קרבו את ה-iPhone כדי לקרוא את השיחה."
          }
        }
      }
    },
    "Can’t Check Mail": {
      "comment": "Below the Inbox when the watch's own checks for mail keep failing",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לבדוק דואר"
          }
        }
      }
    },
    "Can’t Load Conversation": {
      "comment": "Shown when the watch couldn't fetch a conversation from the mail service",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לטעון את השיחה"
          }
        }
      }
    },
    "Checking for Mail…": {
      "comment": "Below the Inbox while the watch checks for new mail itself",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק אם יש דואר…"
          }
        }
      }
    },
    "Code": {
      "comment": "Above a one-time code in a conversation",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד"
          }
        }
      }
    },
    "Conversation Gone": {
      "comment": "Shown when the iPhone no longer has the conversation",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיחה כבר לא כאן"
          }
        }
      }
    },
    "Dictate or Scribble": {
      "comment": "The reply field's placeholder",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכתבה או כתב יד"
          }
        }
      }
    },
    "Inbox": {
      "comment": "The Inbox screen's title",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דואר נכנס"
          }
        }
      }
    },
    "It was moved or deleted on another device.": {
      "comment": "Shown when the iPhone no longer has the conversation",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היא הועברה או נמחקה במכשיר אחר."
          }
        }
      }
    },
    "Marked Read": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומנה כנקראה"
          }
        }
      }
    },
    "Marked Unread": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סומנה כלא נקראה"
          }
        }
      }
    },
    "More": {
      "comment": "Opens Pin and Snooze",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד"
          }
        }
      }
    },
    "Moved to Inbox": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועברה לדואר נכנס"
          }
        }
      }
    },
    "Moved to Trash": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועברה לפח"
          }
        }
      }
    },
    "Needs iPhone": {
      "comment": "On a row, or in place of a conversation, of an account only the iPhone can read, when the iPhone has been quiet or didn't answer",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צריך את ה-iPhone"
          }
        }
      }
    },
    "Next Week": {
      "comment": "Snooze time: the morning the week resumes",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשבוע הבא"
          }
        }
      }
    },
    "No Accounts": {
      "comment": "Shown with no mail accounts",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חשבונות"
          }
        }
      }
    },
    "No Unread Mail": {
      "comment": "Watch face: nothing unread",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין דואר שלא נקרא"
          }
        }
      }
    },
    "Nothing in your Inbox.": {
      "comment": "Shown when the Inbox is empty",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיבת הדואר הנכנס ריקה."
          }
        }
      }
    },
    "OK": {
      "comment": "Dismisses the failed reply alert",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור"
          }
        }
      }
    },
    "Open Goodmail on iPhone": {
      "comment": "Shown before the iPhone has sent any mail",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לפתוח את Goodmail ב‑iPhone"
          }
        }
      }
    },
    "Pin": {
      "comment": "Pins a conversation to the top",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעיצה"
          }
        }
      }
    },
    "Pinned": {
      "comment": "VoiceOver: a pinned row",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוצמדת"
          }
        }
      }
    },
    "Read": {
      "comment": "Swipe action: mark as read",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקראה"
          }
        }
      }
    },
    "Read Message": {
      "comment": "A long message's footer, which opens it in full",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקריאת ההודעה"
          }
        }
      }
    },
    "Reply": {
      "comment": "Reply: the screen, its field and the button that opens it",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תשובה"
          }
        }
      }
    },
    "Reply Not Sent": {
      "comment": "Alert: a reply from the watch failed",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה לא נשלחה"
          }
        }
      }
    },
    "Reply Sent": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשובה נשלחה"
          }
        }
      }
    },
    "Restored": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שוחזרה"
          }
        }
      }
    },
    "Sending…": {
      "comment": "Shown while a reply waits for Undo",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח…"
          }
        }
      }
    },
    "Sign in again on your iPhone.": {
      "comment": "Why the watch can't check mail: the service turned the sign-in down",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צריך להתחבר שוב ב-iPhone."
          }
        }
      }
    },
    "Snooze Until": {
      "comment": "Above the snooze times",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נודניק עד"
          }
        }
      }
    },
    "Snoozed": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הועבר לנודניק"
          }
        }
      }
    },
    "Something went wrong.": {
      "comment": "Why the watch can't check mail: an error with no better description",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משהו השתבש."
          }
        }
      }
    },
    "The connection isn’t secure.": {
      "comment": "Why the watch can't check mail: the server's certificate isn't valid",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיבור לא מאובטח."
          }
        }
      }
    },
    "The mail service didn’t answer.": {
      "comment": "Why the watch can't check mail: the server couldn't be reached or timed out",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות הדואר לא ענה."
          }
        }
      }
    },
    "The rest of this message is on your iPhone.": {
      "comment": "Below a message the watch could get only the start of",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך ההודעה נמצא ב-iPhone."
          }
        }
      }
    },
    "The watch is offline.": {
      "comment": "Why the watch can't check mail: no internet connection",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השעון לא מחובר לאינטרנט."
          }
        }
      }
    },
    "This Evening": {
      "comment": "Snooze time: 6 PM today",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערב"
          }
        }
      }
    },
    "This Weekend": {
      "comment": "Snooze time: the weekend's first morning",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בסוף השבוע"
          }
        }
      }
    },
    "Tomorrow": {
      "comment": "Snooze time: 8 AM tomorrow",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחר"
          }
        }
      }
    },
    "Tonight": {
      "comment": "Snooze time: 9 PM today",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הלילה"
          }
        }
      }
    },
    "Trash": {
      "comment": "Swipe action: move to Trash",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פח"
          }
        }
      }
    },
    "Try Again": {
      "comment": "Tries the same thing again",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לנסות שוב"
          }
        }
      }
    },
    "Undo": {
      "comment": "Takes back a reply before it goes",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול"
          }
        }
      }
    },
    "Unpin": {
      "comment": "Unpins a conversation",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול נעיצה"
          }
        }
      }
    },
    "Unpinned": {
      "comment": "Undo button: what was done",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההצמדה בוטלה"
          }
        }
      }
    },
    "Unread": {
      "comment": "VoiceOver: an unread row",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נקראה"
          }
        }
      }
    },
    "Update Goodmail": {
      "comment": "Shown when the iPhone app is newer than the watch app",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לעדכן את Goodmail"
          }
        }
      }
    },
    "Updated %@": {
      "comment": "Below the Inbox: when the watch last checked for mail itself, as in “Updated 2 min. ago”",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עודכן %@"
          }
        }
      }
    },
    "Waiting for iPhone": {
      "comment": "VoiceOver, watch face: the iPhone hasn't sent the Inbox yet",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממתין ל-iPhone"
          }
        }
      }
    },
    "You": {
      "comment": "VoiceOver: before the reader's own message",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני"
          }
        }
      }
    },
    "Your iPhone couldn't send “%@”.": {
      "comment": "Alert: a reply from the watch failed; the reply's words",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-iPhone לא הצליח לשלוח את „%@”."
          }
        }
      }
    },
    "Your iPhone has a newer Goodmail. Update this app to see your mail.": {
      "comment": "Shown when the iPhone app is newer than the watch app",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ב‑iPhone יש גרסה חדשה יותר של Goodmail. יש לעדכן את האפליקציה הזו כדי לראות את הדואר."
          }
        }
      }
    },
    "Your mail shows here once the iPhone app has synced.": {
      "comment": "Shown before the iPhone has sent any mail",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדואר יופיע כאן אחרי שהאפליקציה ב‑iPhone תסתנכרן."
          }
        }
      }
    }
  },
  "version": "1.0"
}
