{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld messages" : {
      "comment" : "How many messages a thread holds",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld message"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld messages"
                }
              }
            }
          }
        },
        "he" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "הודעה אחת"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld הודעות"
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "שתי הודעות"
                }
              }
            }
          }
        }
      }
    },
    "Attach" : {
      "comment" : "Adds files to the message",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צירוף"
          }
        }
      }
    },
    "Copy" : {
      "comment" : "Copies a bubble's text",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העתקה"
          }
        }
      }
    },
    "Couldn’t Open Attachment" : {
      "comment" : "Alert title when an attachment fails to download",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לפתוח את הקובץ המצורף"
          }
        }
      }
    },
    "Edit Draft" : {
      "comment" : "Opens a saved draft to finish it",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערוך טיוטה"
          }
        }
      }
    },
    "Forward" : {
      "comment" : "Forwards the message",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "העבר"
          }
        }
      }
    },
    "Go to Quoted Message" : {
      "comment" : "Scrolls to the message a bubble answers",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבר להודעה המצוטטת"
          }
        }
      }
    },
    "Hide Mail Actions" : {
      "comment" : "Folds the chat's mail actions away",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסתרת פעולות הדואר"
          }
        }
      }
    },
    "Load Remote Images" : {
      "comment" : "Shows blocked remote content",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "טעינת תמונות מרוחקות"
          }
        }
      }
    },
    "Mail Actions" : {
      "comment" : "Unfolds archive, trash and the rest",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולות דואר"
          }
        }
      }
    },
    "Message" : {
      "comment" : "The chat's reply field, and its placeholder",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודעה"
          }
        }
      }
    },
    "No Message Selected" : {
      "comment" : "Shown beside the message list when no conversation is open.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Message Selected"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא נבחרה הודעה"
          }
        }
      }
    },
    "OK" : {
      "comment" : "Dismiss",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אישור"
          }
        }
      }
    },
    "Open %@" : {
      "comment" : "Opens a link from a bubble; the argument is the site",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתיחת %@"
          }
        }
      }
    },
    "Open Message" : {
      "comment" : "Opens a long message from its bubble",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פתיחת ההודעה"
          }
        }
      }
    },
    "Opens the whole message" : {
      "comment" : "VoiceOver hint on a long message's bubble",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פותח את ההודעה המלאה"
          }
        }
      }
    },
    "Quote: %@" : {
      "comment" : "VoiceOver: lines a message answers inline",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ציטוט: %@"
          }
        }
      }
    },
    "Reply" : {
      "comment" : "Composer title for a reply",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השב"
          }
        }
      }
    },
    "Reply All" : {
      "comment" : "Replies to everyone",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השב לכולם"
          }
        }
      }
    },
    "Replying to %@: %@" : {
      "comment" : "VoiceOver: the earlier message a bubble answers",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתגובה ל%1$@: %2$@"
          }
        }
      }
    },
    "Send" : {
      "comment" : "Sends the chat reply",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלח"
          }
        }
      }
    },
    "Show Full Message" : {
      "comment" : "Opens a bubble's whole email",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת ההודעה המלאה"
          }
        }
      }
    },
    "Show Quoted Text" : {
      "comment" : "Accessibility label of the fold",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגת טקסט מצוטט"
          }
        }
      }
    },
    "Show as %@" : {
      "comment" : "Switches one conversation's layout; the argument is Classic or Chat",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגה כ%@"
          }
        }
      }
    },
    "You" : {
      "comment" : "VoiceOver: the reader, as the sender of a bubble",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "את/ה"
          }
        }
      }
    },
    "me" : {
      "comment" : "The reader, in a recipient list",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני"
          }
        }
      }
    },
    "to %@" : {
      "comment" : "Recipients under the sender; the argument is a list of names",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אל %@"
          }
        }
      }
