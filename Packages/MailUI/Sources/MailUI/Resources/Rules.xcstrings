          }
        }
      }
    },
    "Received Within the Last" : {
      "comment" : "Condition: received at most this long ago",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התקבלה במהלך ה־"
          }
        }
      }
    },
    "Rules" : {
      "comment" : "Title of the mail rules screen",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כללים"
          }
        }
      }
    },
    "Rules act on new mail as it arrives: snooze it, file it, flag it, or tell a shortcut." : {
      "comment" : "Explains mail rules under their Settings row",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כללים פועלים על דואר חדש ברגע שהוא מגיע: נודניק, תיוק, סימון בדגל או הפעלת קיצור."
          }
        }
      }
    },
    "Rules run in this order on each new message from someone else. To run a shortcut when mail arrives, give a rule Notify with Keyword, then in Shortcuts make an automation for Goodmail notifications that contain the keyword." : {
      "comment" : "Explains rule order and how to start a shortcut from a rule",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכללים פועלים לפי הסדר הזה על כל הודעה חדשה שמישהו אחר שלח. כדי להפעיל קיצור כשמגיע דואר, הוסיפו לכלל ״התראה עם מילת מפתח״, ואז צרו ב״קיצורים״ אוטומציה להתראות של Goodmail שמכילות את מילת המפתח."
          }
        }
      }
    },
    "Stop Other Rules" : {
      "comment" : "Toggle: rules after this one skip the mail it acted on",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עצירת שאר הכללים"
          }
        }
      }
    },
    "Try Again" : {
      "comment" : "Reads the rules again",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ניסיון נוסף"
          }
        }
      }
    },
    "Unit" : {
      "comment" : "Hours, days or weeks",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יחידה"
          }
        }
      }
    },
    "Value" : {
      "comment" : "Placeholder: text to match",
      "localizations" : {
