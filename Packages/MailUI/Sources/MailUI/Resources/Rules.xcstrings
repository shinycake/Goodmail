    },
    "When a Message Arrives" : {
      "comment" : "Header of the conditions",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשמגיעה הודעה"
          }
        }
      }
    },
    "When this rule acts on a message, the rules after it leave that message alone." : {
      "comment" : "Explains Stop Other Rules",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהכלל הזה פועל על הודעה, הכללים שאחריו לא נוגעים בה."
          }
        }
      }
    },
    "Yes" : {
      "comment" : "The status holds",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כן"
          }
        }
      }
    }
