                  "state" : "translated",
                  "value" : "%lld line"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld lines"
                }
              }
            }
          }
        },
        "he" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "שורה אחת"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld שורות"
                }
              }
            }
          }
        }
      }
    },
    "A name for this account, like Work or Personal, shown instead of its address. Only you see it." : {
      "comment" : "Explains an account's description",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם לחשבון הזה, כמו ״עבודה״ או ״אישי״, שמוצג במקום הכתובת שלו. רק לך הוא מוצג."
          }
        }
      }
    },
    "Accounts" : {
      "comment" : "Settings section listing the accounts",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות"
          }
        }
      }
    },
