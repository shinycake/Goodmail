      "comment" : "Settings section for an account's alerts",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התראות"
          }
        }
      }
    },
    "Notifications for Goodmail are turned off in Settings." : {
      "comment" : "Explains why no alerts arrive",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתראות של Goodmail כבויות בהגדרות."
          }
        }
      }
    },
    "Playful" : {
      "comment" : "Removal animation: rows go into a trash can or archive box, or dissolve",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שובב"
          }
        }
      }
    },
    "Playful puts mail into the trash can or archive box, and dissolves mail deleted forever. Subtle slides it away." : {
      "comment" : "Explains the delete and archive animation setting",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״שובב״ מכניס את הדואר לפח או לתיבת הארכיון, ומפורר דואר שנמחק לצמיתות. ״עדין״ פשוט מחליק אותו החוצה."
          }
        }
      }
    },
    "Preview" : {
      "comment" : "Setting for how much of each message a mailbox row shows",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תצוגה מקדימה"
          }
        }
      }
    },
    "Preview: None" : {
      "comment" : "Mailbox rows show no preview",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "None"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ללא"
          }
        }
      }
    },
    "Primary Only" : {
      "comment" : "Alert choice: only Primary-category mail",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ראשי בלבד"
          }
        }
      }
    },
    "Primary Only skips Promotions, Social, Updates and Forums." : {
      "comment" : "Explains the Primary Only alert choice",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "״ראשי בלבד״ מדלג על קידומי מכירות, רשתות חברתיות, עדכונים ופורומים."
          }
        }
      }
    },
    "Remove Account" : {
      "comment" : "Removes an account from the device",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסר חשבון"
          }
        }
      }
    },
    "Remove Account?" : {
      "comment" : "Asks before removing an account",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להסיר את החשבון?"
          }
        }
      }
    },
    "Settings" : {
      "comment" : "Title of the settings screen",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדרות"
          }
        }
      }
    },
    "Shown to the people you write to from %@." : {
      "comment" : "Explains an account's sender name",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוצג לנמענים של הודעות מ-%@."
          }
        }
      }
    },
    "Something Went Wrong" : {
      "comment" : "Title of a settings failure alert",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משהו השתבש"
          }
        }
      }
    },
    "Sorts the Inbox into Primary, Promotions, Social, Updates and Forums, as Gmail does." : {
      "comment" : "Explains the Inbox Categories setting",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממיין את הדואר הנכנס לראשי, קידומי מכירות, רשתות חברתיות, עדכונים ופורומים, כמו ב-Gmail."
          }
        }
      }
    },
    "Sorts the Inbox into Primary, Promotions, Social, Updates and Forums, as Gmail does. Each account can also choose in its own settings." : {
      "comment" : "Explains the Inbox Categories setting that covers every Gmail account",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ממיין את הדואר הנכנס לראשי, קידומי מכירות, רשתות חברתיות, עדכונים ופורומים, כמו ב-Gmail. אפשר גם לבחור לכל חשבון בהגדרות שלו."
          }
        }
      }
    },
    "Subtle" : {
      "comment" : "Removal animation: rows slide away with the standard animation",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדין"
          }
        }
      }
    },
    "Theme" : {
      "comment" : "Settings section for the color of views showing every account",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ערכת נושא"
          }
        }
      }
    },
    "Turn On in Settings" : {
      "comment" : "Opens iOS Settings to allow alerts",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפעלה בהגדרות"
          }
        }
      }
    },
    "Undo Send" : {
      "comment" : "Setting for how long a sent message can be taken back",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביטול שליחה"
          }
        }
      }
    },
    "Undo Send: Off" : {
      "comment" : "Undo Send is turned off",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבוי"
          }
        }
      }
    },
    "Views that show every account, like the unified inbox, wear a gradient of your account colors. Turn it off to choose one color." : {
      "comment" : "Explains the Gradient setting",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תצוגות שמציגות את כל החשבונות, כמו תיבת הדואר המאוחדת, נצבעות במעבר בין צבעי החשבונות שלך. אפשר לכבות זאת ולבחור צבע אחד."
          }
        }
      }
    },
    "Without avatars, a dot beside a row still marks unread mail." : {
      "comment" : "Explains turning avatars off",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גם בלי תמונות פרופיל, נקודה ליד שורה מסמנת דואר שלא נקרא."
          }
        }
      }
    },
    "Your Name" : {
      "comment" : "Placeholder for an account's sender name",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השם שלך"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
