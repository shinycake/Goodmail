      }
    },
    "Chat shows each message's new words as bubbles. Switch one conversation from its toolbar." : {
      "comment" : "Explains the conversation layout setting",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתצוגת צ׳אט כל הודעה מוצגת כבועה, בלי הציטוטים והחתימה. אפשר להחליף תצוגה לשיחה אחת מסרגל הכלים שלה."
          }
        }
      }
    },
    "Classic" : {
      "comment" : "Conversation layout: each message as a letter",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קלאסי"
          }
        }
      }
    },
