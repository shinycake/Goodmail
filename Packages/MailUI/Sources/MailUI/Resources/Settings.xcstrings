          "stringUnit" : {
            "state" : "translated",
            "value" : "שם"
          }
        }
      }
    },
    "Preview" : {
      "comment" : "Setting for how much of each message a mailbox row shows",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תצוגה מקדימה"
          }
        }
      }
    },
    "Preview: None" : {
      "comment" : "Mailbox rows show no preview",
      "localizations" : {
        "en" : {
          "stringUnit" : {
