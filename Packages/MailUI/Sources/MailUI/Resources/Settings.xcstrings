        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוסף חשבון"
          }
        }
      }
    },
    "Avatars" : {
      "comment" : "Setting for the sender's initials beside each row",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונות פרופיל"
          }
        }
      }
    },
    "Color" : {
      "comment" : "Settings section for an account's theme color",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צבע"
          }
        }
      }
    },
    "Gradient" : {
      "comment" : "Setting for a gradient of every account's color",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעבר צבעים"
          }
        }
      }
    },
    "How long a sent message waits, so you can take it back." : {
      "comment" : "Explains the Undo Send setting",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמה זמן הודעה שנשלחה ממתינה, כדי שתוכל לבטל אותה."
          }
        }
      }
    },
    "Inbox Categories" : {
      "comment" : "Settings section for Gmail's Inbox categories",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קטגוריות בדואר הנכנס"
          }
        }
      }
    },
    "Mail List" : {
      "comment" : "Settings section for how mailbox rows look",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשימת הדואר"
          }
        }
      }
    },
    "Name" : {
      "comment" : "Label of an account's sender name field",
      "localizations" : {
