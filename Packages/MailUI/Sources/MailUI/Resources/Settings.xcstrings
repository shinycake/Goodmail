{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ and its mail are removed from this device. Nothing is deleted from Gmail." : {
      "comment" : "Explains what removing an account does",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏%@ והדואר שלו יוסרו מהמכשיר הזה. שום דבר לא יימחק מ-Gmail."
          }
        }
      }
    },
    "%lld lines" : {
      "comment" : "Mailbox rows show this many lines of preview",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld line"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld lines"
                }
              }
            }
          }
        },
        "he" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "שורה אחת"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld שורות"
                }
              }
            }
          }
        }
      }
    },
    "Accounts" : {
      "comment" : "Settings section listing the accounts",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חשבונות"
          }
        }
      }
    },
