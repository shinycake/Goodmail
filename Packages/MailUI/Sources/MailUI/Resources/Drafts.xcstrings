{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld Drafts" : {
      "comment" : "VoiceOver label of the drafts pill: how many messages are minimized",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Draft"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Drafts"
                }
              }
            }
          }
        },
        "he" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "טיוטה אחת"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld טיוטות"
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "שתי טיוטות"
                }
              }
            }
          }
        }
      }
    },
    "Cancel" : {
      "comment" : "Keeps the draft",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביטול"
          }
        }
      }
    },
    "Close %@" : {
      "comment" : "VoiceOver: the close button of a minimized message; the argument is its title",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סגירת %@"
          }
        }
      }
    },
    "Message minimized" : {
      "comment" : "VoiceOver announcement after the composer shrinks into the drafts pill",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההודעה מוזערה"
          }
        }
      }
    },
    "Minimize" : {
      "comment" : "VoiceOver: the grabber at the top of the composer, which minimizes the message into the drafts pill",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מזעור"
          }
        }
      }
    },
    "Opens the message." : {
      "comment" : "VoiceOver hint of the drafts pill holding one message, and of a laid-out draft",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פותח את ההודעה."
          }
        }
      }
    },
    "Puts the message aside to come back to." : {
      "comment" : "VoiceOver hint of the composer's grabber, which minimizes the message into the drafts pill",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם את ההודעה בצד כדי לחזור אליה."
          }
        }
      }
    },
    "Shows the drafts to pick one." : {
      "comment" : "VoiceOver hint of the drafts pill holding several messages",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מציג את הטיוטות לבחירה."
          }
        }
      }
    },
    "To:" : {
      "comment" : "Before who a draft goes to",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אל:"
          }
        }
      }
    }
