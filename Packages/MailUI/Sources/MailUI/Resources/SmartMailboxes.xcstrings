      "comment" : "Header above a smart mailbox's conditions",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיחות שמתאימות"
          }
        }
      }
    },
    "Conversations from these addresses show here, on all your devices." : {
      "comment" : "Explains the VIPs list",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיחות מהכתובות האלה יופיעו כאן, בכל המכשירים שלך."
