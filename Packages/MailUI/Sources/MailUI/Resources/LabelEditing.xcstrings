{
  "sourceLanguage" : "en",
  "strings" : {
    "Cancel" : {
      "comment" : "Button: changes nothing",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביטול"
          }
        }
      }
    },
    "Check your connection and try again." : {
      "comment" : "A label change failed for another reason",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לבדוק את החיבור ולנסות שוב."
          }
        }
      }
    },
    "Couldn’t Create Label" : {
      "comment" : "Title of the alert when the service refused a new label",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן ליצור את התווית"
          }
        }
      }
    },
    "Couldn’t Delete Label" : {
      "comment" : "Title of the alert when deleting a label failed",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן למחוק את התווית"
          }
        }
      }
    },
    "Couldn’t Rename Label" : {
      "comment" : "Title of the alert when the service refused a label's new name",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן לשנות את שם התווית"
          }
        }
      }
    },
    "Create" : {
      "comment" : "Button: creates the label",
