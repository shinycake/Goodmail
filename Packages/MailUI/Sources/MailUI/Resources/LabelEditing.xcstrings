    "The label comes off its conversations, which stay in your mail." : {
      "comment" : "Delete label alert, Gmail: no mail is deleted",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "התווית תוסר מהשיחות שלה, והן יישארו בדואר שלך."
          }
        }
      }
    },
    "Try another name. There may already be a label with this one." : {
      "comment" : "The service refused the label's name",
