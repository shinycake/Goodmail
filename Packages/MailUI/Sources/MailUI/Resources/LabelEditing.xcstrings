        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקה"
          }
        }
      }
    },
    "Delete Label" : {
      "comment" : "Action: deletes the label",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחיקת התווית"
          }
        }
      }
    },
    "Delete “%@”?" : {
      "comment" : "Title of the alert before deleting a label, with its name",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למחוק את ״%@״?"
          }
        }
      }
    },
    "Its mail and the labels inside it move to Deleted Items." : {
      "comment" : "Delete label alert, Outlook: the folder and its mail go to Deleted Items",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדואר שלה והתוויות שבתוכה יועברו אל ״פריטים שנמחקו״."
          }
        }
      }
    },
    "Its mail is deleted from the server for good. You can’t undo this." : {
      "comment" : "Delete label alert, iCloud and IMAP: the folder's messages are deleted",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הדואר שלה יימחק מהשרת לצמיתות. אי אפשר לבטל את הפעולה."
          }
        }
      }
    },
    "Name" : {
      "comment" : "Placeholder: the label's name",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם"
          }
        }
      }
    },
    "New Label" : {
      "comment" : "Action: makes a new label, and the title of the alert that names it",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תווית חדשה"
          }
        }
