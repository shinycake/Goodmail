#!/usr/bin/env bash
# Put a TestFlight build on the public beta, the external "Apple Review" group behind
# https://testflight.apple.com/join/JQPaJxgK. scripts/testflight runs this after every upload, so the
# public link always offers the newest build. It waits for App Store Connect to finish processing,
# adds the build to the group, sets its What to Test notes and submits it for Beta App Review.
#
# Usage: scripts/public-beta [BUILD_NUMBER]   (default: the newest uploaded build)
#
# Safe to rerun: a build already in the group or already submitted is left as it is. If Apple refuses
# the submission while an older build is still in review, the script says so and exits 3. Run it
# again once that review clears (with no arguments it catches up to the newest build).
# Needs `asc` authenticated, like scripts/testflight.
set -euo pipefail
cd "$(dirname "$0")/.."
APP=6834185190 # Goodmail's App Store Connect app ID; publish needs the numeric ID, not the bundle ID.
GROUP="Apple Review"
GROUP_ID=fb09d0a3-8c6e-442c-8bbf-743967cb3836 # its ID, so a slow group list can't make it "not found"
NOTES_LIMIT=3900 # Apple allows 4000 characters of What to Test.

latest_build_number() {
    asc builds list --app "$APP" --platform IOS --sort -uploadedDate --limit 1 --output json |
        python3 -c 'import json, sys; print(json.load(sys.stdin)["data"][0]["attributes"]["version"])'
}

# The commits this build adds since the previous build, taken from the testflight/<number> tags that
# scripts/testflight pushes. Commit subjects are written for people (ADR-028); older ones end in their PR number.
what_to_test() {
    local build="$1" tag="testflight/$1" previous
    git fetch --quiet origin 'refs/tags/testflight/*:refs/tags/testflight/*' 2>/dev/null || true
    echo "Goodmail is a native mail app for Gmail, Outlook, iCloud and other IMAP accounts."
    if git rev-parse --quiet --verify "$tag^{commit}" >/dev/null; then
        previous="$(git tag --list 'testflight/*' --merged "$tag^" --sort=-version:refname | head -1)"
        if [[ -n "$previous" ]]; then
            echo
            echo "New in build $build:"
            git log --no-merges --format='- %s' "$previous..$tag" | sed -E 's/ \(#[0-9]+\)$//'
        fi
    fi
    echo
    echo "Add an account, read and reply to a few threads, and try the swipe actions. If something breaks, take a screenshot in the app and send it through TestFlight."
}

build="${1:-$(latest_build_number)}"
notes="$(what_to_test "$build" | cut -c 1-300)"
if ((${#notes} > NOTES_LIMIT)); then
    notes="${notes:0:NOTES_LIMIT}"$'\n…'
fi

# App Store Connect sometimes times out or answers a list with nothing (build 24's first run reported the
# group as "not found"), so a failed publish is retried before the script gives up.
export ASC_TIMEOUT="${ASC_TIMEOUT:-90s}"
for attempt in 1 2 3; do
    echo "Putting build $build on the public beta ($GROUP), attempt $attempt"
    if asc publish testflight --app "$APP" --build-number "$build" --group "$GROUP_ID" \
        --test-notes "$notes" --locale en-US --submit --confirm --timeout 90m --output table; then
        exit 0
    fi
    pending="$(asc builds list --app "$APP" --platform IOS --beta-review-state WAITING_FOR_REVIEW,IN_REVIEW --output json |
        python3 -c 'import json, sys; print(" ".join(b["attributes"]["version"] for b in json.load(sys.stdin)["data"]))' ||
        true)"
    if [[ -n "$pending" && " $pending " != *" $build "* ]]; then
        echo "Build $build is in the $GROUP group, but Apple is still reviewing build $pending." >&2
        echo "Run scripts/public-beta again once that review clears." >&2
        exit 3
    fi
    ((attempt < 3)) && sleep $((attempt * 60))
done
exit 1
