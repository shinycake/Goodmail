#!/usr/bin/env bash
# The local gate (ADR-013): format lint, the line cap (ADR-014), then package tests and the app's launch tests.
#
#   scripts/check          everything; the pre-push hook runs this
#   scripts/check --lint   format and line cap only; the pre-commit hook and Linux CI run this
#
# Tests run on a dedicated "Goodmail Check" simulator, created on first use, so the unsigned test build never
# replaces the signed dev install (and its Keychain sign-in) on your everyday simulator.
# GOODMAIL_SIMULATOR picks its device type (default: iPhone 18 Pro).
set -euo pipefail
cd "$(dirname "$0")/.."
# Build output lives on the external drive when it's mounted, to spare the internal disk.
BUILD_DIR="${GOODMAIL_BUILD_DIR:-$([[ -d /Volumes/Idan1TB ]] && echo /Volumes/Idan1TB/Goodmail-build || echo "$PWD/.build")}"
# A linked worktree checks with its own build folder and simulator, so checks in parallel worktrees can't collide.
CHECK_NAME="Goodmail Check"
if [[ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]]; then
    worktree=$(basename "$PWD")
    BUILD_DIR="$BUILD_DIR/worktrees/$worktree"
    CHECK_NAME="Goodmail Check $worktree"
fi
mkdir -p "$BUILD_DIR"
# Git sets these for hooks; SwiftPM's own git calls would then act on this repository instead of package checkouts.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX

SWIFT_ROOTS=(Goodmail GoodmailUITests NotificationService Widgets Packages)

step() { printf '\n▸ %s\n' "$1"; }

step "Format (swift format lint --strict)"
swift format lint --strict --recursive --parallel "${SWIFT_ROOTS[@]}"

step "Line cap (fail above 1000, warn above 800)"
over_cap=0
while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    lines=$(wc -l <"$file" | tr -d ' ')
    if ((lines > 1000)); then
        echo "✘ $file has $lines lines. Split it by responsibility."
        over_cap=1
    elif ((lines > 800)); then
        echo "⚠ $file has $lines lines."
    fi
done < <(git ls-files --cached --others --exclude-standard -- '*.swift' '*.ts' ':(exclude)**/Fixtures/**')
((over_cap == 0)) || exit 1

[[ "${1:-}" == "--lint" ]] && exit 0

check_simulator=$(xcrun simctl list devices available | grep -m1 -F "$CHECK_NAME (" | grep -oE '[0-9A-F-]{36}' || true)
if [[ -z "$check_simulator" ]]; then
    check_simulator=$(xcrun simctl create "$CHECK_NAME" "${GOODMAIL_SIMULATOR:-iPhone 18 Pro}")
fi
# Boot it up front: xcodebuild gives a booting simulator only 60 seconds, which a busy Mac can miss.
xcrun simctl bootstatus "$check_simulator" -b >/dev/null
DESTINATION="platform=iOS Simulator,id=$check_simulator"
# Simulators live on the internal disk, so a worktree's own one goes when its check ends.
if [[ "$CHECK_NAME" != "Goodmail Check" ]]; then
    trap 'xcrun simctl shutdown "$check_simulator" >/dev/null 2>&1; xcrun simctl delete "$check_simulator" >/dev/null 2>&1' EXIT
fi

# Each module is its own package (ADR-005); test every one that has tests.
for package in Packages/*/; do
    package=$(basename "$package")
    [[ -d "Packages/$package/Tests" ]] || continue
    step "$package tests ($DESTINATION)"
    (cd "Packages/$package" && xcodebuild test -quiet -scheme "$package" -destination "$DESTINATION" \
        -derivedDataPath "$BUILD_DIR/DerivedData-Packages")
done

step "App build and launch tests in English and Hebrew ($DESTINATION)"
xcodebuild test -quiet -project Goodmail.xcodeproj -scheme Goodmail -destination "$DESTINATION" \
    -derivedDataPath "$BUILD_DIR/DerivedData" -resultBundlePath "$BUILD_DIR/results/check-$(date +%Y%m%d-%H%M%S).xcresult" \
    CODE_SIGNING_ALLOWED=NO

printf '\n✔ scripts/check passed\n'
