#!/usr/bin/env bash
# The local gate (ADR-013): format lint, the line cap (ADR-014), then package tests and the app's launch tests.
#
#   scripts/check          everything; the pre-push hook runs this (Linux: lint, iOS compile, some tests)
#   scripts/check --lint   format and line cap only; the pre-commit hook runs this
#
# Tests run on a dedicated "Goodmail Check" simulator, created on first use, so the unsigned test build never
# replaces the signed dev install (and its Keychain sign-in) on your everyday simulator.
# GOODMAIL_SIMULATOR picks its device type (default: iPhone 18 Pro).
set -euo pipefail
cd "$(dirname "$0")/.."
scripts/cloud/ensure  # a Claude cloud session's toolchain, if it doesn't have it yet
source scripts/build-paths  # BUILD_DIR and CHECK_NAME: this checkout's own build folder and simulator
mkdir -p "$BUILD_DIR"
# Git sets these for hooks; SwiftPM's own git calls would then act on this repository instead of package checkouts.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_PREFIX

SWIFT_ROOTS=(Goodmail GoodmailUITests GoodmailWatch GoodmailWatchWidgets NotificationService ShareExtension Widgets Packages)
# Packages without UIKit or SwiftUI, whose tests also run on Linux (docs/setup/cloud-builds.md).
LINUX_TESTED_PACKAGES=(MailCore GmailProvider MailStore IMAPProvider OutlookProvider MailWrist MailWristHost PlaneGame
    FieldDiagnostics)
# The packages the Apple Watch runs itself (ADR-023), built for watchOS on the Mac.
WATCH_BUILT_PACKAGES=(MailCore MailStore GmailProvider OutlookProvider MailWrist MailWristHost)

step() { printf '\n▸ %s\n' "$1"; }

step "Format (swift format lint --strict)"
swift format lint --strict --recursive --parallel "${SWIFT_ROOTS[@]}"

step "Line cap (fail above 1000, warn above 800)"
# Every text file, code or not (ADR-014). Generated files, recorded fixtures and vendored skills are exempt.
LINE_CAP_EXEMPT=(
    ':(exclude)**/Fixtures/**' ':(exclude)*.xcproj' ':(exclude)**/package-lock.json' ':(exclude)**/Package.resolved'
    ':(exclude).claude/skills/**'
)
over_cap=0
while IFS= read -r file; do
    [[ -f "$file" ]] || continue
    lines=$(wc -l <"$file" | tr -d ' ')
    if ((lines > 1000)); then
        echo "✘ $file has $lines lines. Split it by responsibility."
        over_cap=1
    elif ((lines > 800)); then
        echo "⚠ $file has $lines lines."
    fi
done < <(git ls-files --cached --others --exclude-standard -- . "${LINE_CAP_EXEMPT[@]}" | while IFS= read -r f; do
    grep -Iq . "$f" 2>/dev/null && echo "$f" # text files only
done)
((over_cap == 0)) || exit 1

step "Strict Swift settings (scripts/strict-swift)"
scripts/strict-swift --check

step "App Intent text (scripts/intent-text)"
scripts/intent-text

step "Mac buttons (scripts/configured-buttons)"
scripts/configured-buttons

step "Database reads off the main actor (scripts/blocking-reads)"
scripts/blocking-reads

# The message script ships as plain JavaScript parts (MessageScript), each run in a block of its own, so a part that
# parses on its own also parses in the page. One that doesn't would only show as mail whose card never takes its
# height. Nothing installs node: the Mac has it, and where a runner doesn't, the MailUI tests on the Mac still catch it.
step "Message script syntax (node --check)"
if command -v node >/dev/null; then
    for script in Packages/MailUI/Sources/MailUI/Resources/*.js; do node --check "$script"; done
else
    echo "⚠ node isn't installed, so the message script's syntax goes unchecked here."
fi

[[ "${1:-}" == "--lint" ]] && exit 0

# The push Worker (ADR-006): typecheck and tests, only where its dev tooling is installed (npm install in PushWorker/).
if [[ -d PushWorker/node_modules ]]; then
    step "PushWorker typecheck and tests"
    (cd PushWorker && npm run --silent check)
fi

# Linux cloud workers have no simulator: they compile every package and its tests for iOS, and run the tests of the
# packages that build for Linux too. The Mac runs the rest.
if [[ "$(uname)" == Linux ]]; then
    step "Packages and tests compiled for iOS (scripts/ios-build)"
    scripts/ios-build
    # One scratch folder for all of them, so the modules they share, such as MailCore, compile once.
    for package in "${LINUX_TESTED_PACKAGES[@]}"; do
        step "$package tests on Linux"
        swift test --package-path "Packages/$package" --scratch-path "$BUILD_DIR/linux-packages"
    done
    printf '\n✔ scripts/check passed on Linux: lint, the iOS compile and the %s tests.\n' "${LINUX_TESTED_PACKAGES[*]}"
    exit 0
fi

# Goodmail's leftovers on the Mac: simulators and build folders nobody has used for days (scripts/cleanup). It runs at
# most once every six hours and never fails the check.
scripts/cleanup --if-due || echo "⚠ scripts/cleanup failed; the check goes on."

check_simulator=$(xcrun simctl list devices available | grep -m1 -F "$CHECK_NAME (" | grep -oE '[0-9A-F-]{36}' || true)
if [[ -z "$check_simulator" ]]; then
    check_simulator=$(xcrun simctl create "$CHECK_NAME" "${GOODMAIL_SIMULATOR:-iPhone 18 Pro}")
    # A new iOS 27.2 simulator ignores dark appearance until its first reboot, so the dark accessibility audit would
    # quietly run in light. One boot and shutdown settles it.
    xcrun simctl bootstatus "$check_simulator" -b >/dev/null
    xcrun simctl shutdown "$check_simulator"
fi
# simslim, where installed, switches off the background services tests don't need before the simulator boots, which
# cuts it from about 200 processes to 70 (docs/setup/mac-simulators.md). It never reboots a simulator already booted.
if command -v simslim >/dev/null && xcrun simctl list devices | grep -F "$check_simulator" | grep -qF "(Shutdown)"; then
    simslim on "$check_simulator" --profile scripts/simslim-profile.json --preserve-boot-state >/dev/null ||
        echo "⚠ simslim could not slim $CHECK_NAME; testing on a stock simulator."
fi
# Boot it up front: xcodebuild gives a booting simulator only 60 seconds, which a busy Mac can miss.
xcrun simctl bootstatus "$check_simulator" -b >/dev/null
DESTINATION="platform=iOS Simulator,id=$check_simulator"
# Simulators live on the internal disk, so a worktree's own one goes when its check ends.
if [[ "$CHECK_NAME" != "Goodmail Check" ]]; then
    trap 'xcrun simctl shutdown "$check_simulator" >/dev/null 2>&1; xcrun simctl delete "$check_simulator" >/dev/null 2>&1' EXIT
fi

# Every Swift warning is an error (ADR-021), but a few slip past the compiler's flag, such as ones an Objective-C
# header downgrades, so the Mac build fails on any warning in our sources that reaches the log too.
strict_xcodebuild() {
    local log="$BUILD_DIR/xcodebuild-$$.log"
    mkdir -p "$BUILD_DIR"
    xcodebuild "$@" 2>&1 | tee "$log"
    if grep -E '^/.*\.swift:[0-9]+:[0-9]+: warning:' "$log" | grep -v '/SourcePackages/checkouts/'; then
        echo "✘ Swift warnings above. Fix them: every warning is an error (ADR-021)."
        exit 1
    fi
    rm -f "$log"  # kept only when the build fails, to read
}

# Each module is its own package (ADR-005); test every one that has tests.
for package in Packages/*/; do
    package=$(basename "$package")
    [[ -d "Packages/$package/Tests" ]] || continue
    step "$package tests ($DESTINATION)"
    (cd "Packages/$package" && strict_xcodebuild test -quiet -scheme "$package" -destination "$DESTINATION" \
        -derivedDataPath "$BUILD_DIR/DerivedData-Packages")
done

# The Apple Watch syncs Gmail and Outlook itself (ADR-023), so these packages must also build for watchOS. Only the
# Mac has the watchOS SDK.
for package in "${WATCH_BUILT_PACKAGES[@]}"; do
    step "$package for watchOS"
    (cd "Packages/$package" && strict_xcodebuild build -quiet -scheme "$package" -destination "generic/platform=watchOS" \
        -derivedDataPath "$BUILD_DIR/DerivedData-Watch")
done

# The Mac app (ADR-032). Linux only type-checks it for Mac Catalyst; linking it here catches an API the Mac's UIKit
# lacks, which otherwise shows only when the app won't launch. Unsigned, like the test build, and for Apple silicon
# only, which links the same APIs in half the time.
step "App for Mac Catalyst"
strict_xcodebuild build -quiet -project Goodmail.xcodeproj -scheme Goodmail \
    -destination 'generic/platform=macOS,variant=Mac Catalyst' -derivedDataPath "$BUILD_DIR/DerivedData-Mac" \
    ARCHS=arm64 CODE_SIGNING_ALLOWED=NO

step "App build and launch tests in English and Hebrew ($DESTINATION)"
strict_xcodebuild test -quiet -project Goodmail.xcodeproj -scheme Goodmail -destination "$DESTINATION" \
    -derivedDataPath "$BUILD_DIR/DerivedData" -resultBundlePath "$BUILD_DIR/results/check-$(date +%Y%m%d-%H%M%S).xcresult" \
    CODE_SIGNING_ALLOWED=NO

printf '\n✔ scripts/check passed\n'
