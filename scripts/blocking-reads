#!/usr/bin/env python3
"""Fail when code outside MailStore reaches past `OffMainDatabase` into the blocking database (ADR-043).

Outside MailStore the database is an `OffMainDatabase`: its reads and writes go through `offMain`, which runs them off
the caller's actor, and its streams come from it directly. `blocking` is the `MailDatabase` under it, there only to be
handed whole, as an argument of a call, to the actors and `@concurrent` work that read it on their own executors, as
`MailCommands(store: database.blocking)` does. So `.blocking` may only end an argument: followed by `,` or `)`, inside
parentheses that follow a name, as a call's do. Anything else fails: a call through it, a chain over several lines, a
binding, a parenthesised or tuple value, an array, a capture list. A line may opt out with
`// blocking-reads: allow: <why the binding only reaches code off the main actor>`.

The check is purely syntactic: it can't see what a call does with what it's handed. Handing `blocking` to code that
reads it synchronously on the main actor is caught by the Debug trap in `MailDatabase` instead.
"""

import pathlib
import re
import subprocess
import sys

# `.blocking(` is a call to something else of that name, as `MailRule.blocking(_:named:)`.
BLOCKING = re.compile(r"\.blocking\b(?!\s*\()")
ENDS_ARGUMENT = re.compile(r"\s*[,)]")
ALLOW = re.compile(r"// blocking-reads: allow: \S")
IMPORTS_MAILSTORE = re.compile(
    r"^\s*(@testable\s+)?((public|package|internal|fileprivate|private)\s+)?import\s+MailStore\b", re.M)
OPENING = {")": "(", "]": "[", "}": "{"}


def code_lines(text):
    """The file's lines with comments blanked out, each kept on its own line so numbers still match, and whether
    each line carries the allow marker with a reason."""
    allowed = [bool(ALLOW.search(line)) for line in text.splitlines()]
    # Block comments become as many newlines as they held; line comments and strings that hold `//` are cut at it.
    text = re.sub(r"/\*.*?\*/", lambda m: "\n" * m.group(0).count("\n"), text, flags=re.S)
    lines = [re.sub(r"//.*", "", line) for line in text.splitlines()]
    return lines, allowed


def in_call_arguments(code, start):
    """Whether the innermost bracket open at `start` is a `(` that follows a name, a `)`, a `]`, a `>` or a `?`, as a
    call's argument list does, rather than a parenthesised value, a tuple, an array, a closure or nothing."""
    closers = []
    for index in range(start - 1, -1, -1):
        char = code[index]
        if char in OPENING:
            closers.append(char)
        elif char in "([{":
            if closers:
                closers.pop()
                continue
            if char != "(":
                return False
            before = code[:index].rstrip()
            return bool(before) and (before[-1].isalnum() or before[-1] in "_)]>?!") and not re.search(
                r"\b(return|in|=|throw|await|try)$", before)
    return False


out = subprocess.run(
    ["git", "ls-files", "--cached", "--others", "--exclude-standard", "*.swift"],
    capture_output=True, text=True, check=True,
).stdout
problems = []
for name in out.splitlines():
    path = pathlib.Path(name)
    if name.startswith("Packages/MailStore/") or not path.is_file():
        continue
    text = path.read_text(encoding="utf-8")
    # Only code that sees MailStore can hold an `OffMainDatabase`.
    if not IMPORTS_MAILSTORE.search(text):
        continue
    lines, allowed = code_lines(text)
    # Joined, so a `.blocking` whose `)` or member is on the next line is judged by what follows it.
    code = "\n".join(lines)
    for match in BLOCKING.finditer(code):
        if ENDS_ARGUMENT.match(code, match.end()) and in_call_arguments(code, match.start()):
            continue
        number = code.count("\n", 0, match.start())
        if not allowed[number]:
            problems.append(f"{path}:{number + 1}: {text.splitlines()[number].strip()}")
if problems:
    print("✘ Code outside MailStore reaches into the blocking database, which can read on the main actor.")
    print("  Use offMain, or hand `.blocking` whole as a call's argument to code that runs off the main actor:")
    for problem in problems:
        print(f"  {problem}")
    sys.exit(1)
print("Outside MailStore, the blocking database is only handed on whole.")
