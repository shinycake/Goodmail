#!/usr/bin/env bash
# Seeds the TestMail corpus into the test account and records Gmail's responses as fixtures (ADR-010).
# Needs the dev simulator signed in to the test account (scripts/run, then sign in once).
#
#   scripts/record-fixtures            seed what's missing, then record every corpus thread
#
# The recorded JSON goes to Packages/GoodmailKit/Tests/GmailProviderTests/Fixtures/Recorded, with the
# account's real address replaced by tester@example.com.
set -euo pipefail
cd "$(dirname "$0")/.."

simulator="${GOODMAIL_DEV_SIMULATOR:-iPhone 18 Pro}"
out="$PWD/Packages/GoodmailKit/Tests/GmailProviderTests/Fixtures/Recorded"
staging="$PWD/.build/recording"
rm -rf "$staging"
TestMail/generate.py

scripts/run -GoodmailSeedTestMail "$PWD/TestMail" -GoodmailRecordFixtures "$staging" >/dev/null
for _ in $(seq 1 90); do
    [[ -n "$(ls "$staging" 2>/dev/null)" ]] && [[ -z "$(find "$staging" -newermt '-5 seconds' 2>/dev/null)" ]] && break
    sleep 2
done
[[ -n "$(ls "$staging" 2>/dev/null)" ]] || { echo "✘ nothing recorded; is the simulator signed in?"; exit 1; }

account=$(sqlite3 "$(find ~/Library/Developer/CoreSimulator/Devices/"$(xcrun simctl list devices booted | grep -m1 "$simulator (" | grep -oE '[0-9A-F-]{36}')"/data/Containers/Shared/AppGroup -name mail.sqlite | head -1)" "SELECT email FROM account ORDER BY createdAt LIMIT 1")
mkdir -p "$out"
for file in "$staging"/*.json; do
    sed "s/${account//./\\.}/tester@example.com/g" "$file" | python3 -m json.tool --indent 1 --no-ensure-ascii >"$out/$(basename "$file")"
done
echo "✔ recorded $(ls "$out" | wc -l | tr -d ' ') fixtures into ${out#$PWD/}"
