  "files": [
    { "path": "WidgetsExtension.entitlements" },
    { "kind": "folder", "path": "Goodmail", "target-membership": [ "Goodmail" ] },
    { "kind": "folder", "path": "GoodmailUITests", "target-membership": [ "GoodmailUITests" ] },
    {
      "kind": "folder",
      "path": "NotificationService",
      "target-membership": [
        "NotificationService",
      ],
      "membership-exceptions": [
        {
          "target": "NotificationService",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Widgets",
      "target-membership": [
        "WidgetsExtension",
      ],
      "membership-exceptions": [
        {
          "target": "WidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "WidgetsExtension/frameworks" ] },
        { "path": "/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "WidgetsExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Goodmail.app", "id": "EE86ADF83088277F00B33018", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/GoodmailUITests.xctest", "id": "EE86AE0F3088278100B33018", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/NotificationService.appex", "id": "EE86AE2C30882AEB00B33018", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Goodmail/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WidgetsExtension.appex", "id": "EE86AE3B30882AEC00B33018", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Goodmail/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Goodmail",
      "id": "EE86ADF73088277F00B33018",
      "product": "Products/Goodmail.app",
      "product-type": "application",
      "dependencies": [
        "NotificationService",
        "WidgetsExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "GmailProvider",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "ICloudProvider",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MailCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MailStore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MailUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "OutlookProvider",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Goodmail/Goodmail.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
