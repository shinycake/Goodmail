#!/usr/bin/env bash
# The merge queue's last step (docs/setup/merge-queue.md): acts on the verifier's verdict (VERDICT) for the planned PR.
#
#   verified   squash the PR's head onto the main the verifier used (MAIN), make sure the tree is the one it verified
#              (TREE), and fast-forward main to it. Main only ever fast-forwards: if it moved, the push fails and the
#              next sweep tries again on the new main.
#   conflict   or failed: put the reason on the PR, which stays stuck until main moves or the author pushes
#   otherwise  the verifier didn't finish (a runner or toolchain failure): the next scheduled sweep tries again
#
# Then it starts the next sweep, so the queue drains one PR at a time without anyone watching it.
set -euo pipefail
# shellcheck source=.github/merge-queue/lib.sh
source "$(dirname "$0")/lib.sh"
git config --global --add safe.directory "$PWD"
on_main=$(stamp "$MAIN")

land() {
    local head state labels
    read -r head state < <(gh api "repos/$R/pulls/$PR" --jq '"\(.head.sha) \(.state)"')
    labels=$(gh api "repos/$R/issues/$PR/labels" --jq '.[].name')
    if [[ "$head" != "$SHA" || "$state" != open ]] || grep -qx hold <<<"$labels"; then
        echo "▸ #$PR changed while it was verified; the next sweep looks at it again."
        return
    fi

    # Every commit is the PR author's, under their noreply address, so public history never carries a personal email.
    local noreply="$AUTHOR_ID+$AUTHOR_LOGIN@users.noreply.github.com"
    export GIT_AUTHOR_NAME="$AUTHOR_LOGIN" GIT_AUTHOR_EMAIL="$noreply"
    export GIT_COMMITTER_NAME="$AUTHOR_LOGIN" GIT_COMMITTER_EMAIL="$noreply"
    git fetch -q origin "$MAIN" "$SHA"
    git checkout -q --detach "$MAIN"
    git merge -q --squash "$SHA"
    git commit -q -m "$(gh api "repos/$R/pulls/$PR" --jq .title) (#$PR)"
    local squash
    squash=$(git rev-parse HEAD)
    if [[ "$(git rev-parse 'HEAD^{tree}')" != "$TREE" ]]; then
        echo "::error::The squash of #$PR isn't the tree that was verified."
        exit 1
    fi
    # GitHub marks a PR merged only when its head is already the squash as main arrives at it: pushing both in one
    # push, or main first, shows the PR as closed. So the squash goes on the branch first, under a lease on the
    # reviewed head, which stops the merge if the branch got a push since. Then main, not forced: it moves only if it
    # is still the commit the squash was verified on. If it moved, the branch goes back to the reviewed head, and the
    # next sweep checks the PR against the new main.
    if ! git push -q --force-with-lease="refs/heads/$REF:$SHA" origin "$squash:refs/heads/$REF"; then
        echo "▸ #$PR got a push during the merge; the next sweep looks at it again."
        return
    fi
    if ! git push -q origin "$squash:refs/heads/main"; then
        git push -q --force-with-lease="refs/heads/$REF:$squash" origin "$SHA:refs/heads/$REF"
        echo "▸ Main moved during the merge; the next sweep checks #$PR against it."
        return
    fi
    for _ in 1 2 3 4 5 6; do
        [[ $(gh api "repos/$R/pulls/$PR" --jq .merged) == true ]] && break
        sleep 5
    done
    if [[ $(gh api "repos/$R/pulls/$PR" --jq .merged) != true ]]; then
        gh pr close "$PR" -R "$R" --comment "Merged to main as $squash by the merge queue."
    fi
    git push -q origin --delete "$REF" || true
    report "$SHA" success "Merged to main as ${squash:0:7}."
    echo "▸ Merged #$PR as ${squash:0:7}." | tee -a "$GITHUB_STEP_SUMMARY"
}

case "$VERDICT" in
    verified) land ;;
    conflict)
        report "$SHA" failure "It conflicts with main. Merge main into the branch and push. $on_main"
        notify "$PR" "conflict $SHA $MAIN" "The merge queue can't merge this: it conflicts with main at ${MAIN:0:7}. Merge main into the branch and push."
        ;;
    failed)
        report "$SHA" failure "scripts/check fails on it squashed onto main. See the merge queue's log. $on_main"
        notify "$PR" "check $SHA $MAIN" "Approved, but \`scripts/check\` fails twice on this PR squashed onto main at ${MAIN:0:7}: $RUN_URL. Fix it on the branch and push; the queue tries again whenever main moves too."
        ;;
    *)
        echo "::warning::The verifier didn't finish; the next scheduled sweep tries #$PR again."
        exit 0
        ;;
esac
next_sweep
