#!/usr/bin/env bash
# The merge queue's verifier (docs/setup/merge-queue.md), run from a checkout of main with read-only access. TRAIN is
# the planner's train: the PRs that can merge, oldest first, as a JSON array of {pr, sha, tree, ...}.
#
#   verify squash   squashes each PR of the train onto main in turn, one commit each, and stops before the first one
#                   that conflicts. Outputs main; cars, the PRs it squashed, as a JSON array of {pr, tree}; and state:
#                     conflict    the first PR conflicts with main, and nothing else is checked
#                     verified    a train of one PR whose review run checked this exact tree
#                     unverified  anything else, so the squash needs its own check
#   verify check    runs scripts/check on the whole train. If that fails and the train has more than one PR, it checks
#                   the first PR alone, so a later PR that breaks the train doesn't hold up the first. That PR
#                   is checked once more if it fails, in case a test is flaky. Outputs state, verified or failed,
#                   and count, how many PRs of the train, from the first, the verdict covers.
set -euo pipefail
git config --global --add safe.directory "$PWD"
export GIT_AUTHOR_NAME=merge-queue GIT_AUTHOR_EMAIL=merge-queue@users.noreply.github.com
export GIT_COMMITTER_NAME=merge-queue GIT_COMMITTER_EMAIL=merge-queue@users.noreply.github.com

if [[ "$HAS_SDK_KEY" == true ]]; then check=(scripts/check); else check=(scripts/check --lint); fi

case "${1:-}" in
    squash)
        main=$(git rev-parse HEAD)
        echo "main=$main" >>"$GITHUB_OUTPUT"
        cars='[]'
        while IFS=$'\t' read -r pr sha; do
            git fetch -q origin "$sha"
            if ! git merge -q --squash "$sha"; then
                git reset -q --hard
                echo "▸ #$pr conflicts with the train at $(git rev-parse --short HEAD)."
                break
            fi
            git commit -q -m "Squash of #$pr"
            cars=$(jq -c --arg pr "$pr" --arg tree "$(git rev-parse 'HEAD^{tree}')" '. + [{pr: $pr, tree: $tree}]' <<<"$cars")
        done < <(jq -r '.[] | [.pr, .sha] | @tsv' <<<"$TRAIN")
        echo "cars=$cars" >>"$GITHUB_OUTPUT"

        count=$(jq length <<<"$cars")
        if ((count == 0)); then
            echo "▸ #$(jq -r '.[0].pr' <<<"$TRAIN") conflicts with main at ${main:0:7}."
            echo "state=conflict" >>"$GITHUB_OUTPUT"
        elif ((count == 1)) && [[ "$(jq -r '.[0].tree' <<<"$cars")" == "$(jq -r '.[0].tree' <<<"$TRAIN")" ]]; then
            echo "▸ The review run checked this exact tree; no need to check again."
            echo "state=verified" >>"$GITHUB_OUTPUT"
            echo "count=1" >>"$GITHUB_OUTPUT"
        else
            echo "▸ Checking $(jq -r 'map("#" + .pr) | join(", ")' <<<"$cars") squashed onto ${main:0:7}."
            echo "state=unverified" >>"$GITHUB_OUTPUT"
        fi
        ;;
    check)
        count=$(jq length <<<"$CARS")
        if ((count > 1)); then
            if "${check[@]}"; then
                printf 'state=verified\ncount=%s\n' "$count" >>"$GITHUB_OUTPUT"
                exit 0
            fi
            echo "::warning::scripts/check failed on the train; checking #$(jq -r '.[0].pr' <<<"$CARS") alone."
            git checkout -q "HEAD~$((count - 1))"
        fi
        for attempt in 1 2; do
            if "${check[@]}"; then
                printf 'state=verified\ncount=1\n' >>"$GITHUB_OUTPUT"
                exit 0
            fi
            echo "::warning::scripts/check failed on attempt $attempt."
        done
        echo "state=failed" >>"$GITHUB_OUTPUT"
        ;;
    *)
        echo "usage: verify squash|check" >&2
        exit 2
        ;;
esac
