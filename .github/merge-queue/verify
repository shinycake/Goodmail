#!/usr/bin/env bash
# The merge queue's verifier (docs/setup/merge-queue.md), run from a checkout of main with read-only access.
#
#   verify squash   squashes the PR's head (SHA) onto main and compares the tree with the one its review run checked
#                   (CHECKED_TREE). Outputs main, tree, and state: conflict, verified (the same tree was checked) or
#                   unverified (main moved since, so the squash needs its own check)
#   verify check    runs scripts/check on that squash, once more if it fails, in case a test is flaky. Outputs
#                   state: verified or failed
set -euo pipefail
git config --global --add safe.directory "$PWD"
export GIT_AUTHOR_NAME=merge-queue GIT_AUTHOR_EMAIL=merge-queue@users.noreply.github.com
export GIT_COMMITTER_NAME=merge-queue GIT_COMMITTER_EMAIL=merge-queue@users.noreply.github.com

case "${1:-}" in
    squash)
        main=$(git rev-parse HEAD)
        git fetch -q origin "$SHA"
        echo "main=$main" >>"$GITHUB_OUTPUT"
        if ! git merge -q --squash "$SHA"; then
            echo "▸ #$PR conflicts with main at ${main:0:7}."
            echo "state=conflict" >>"$GITHUB_OUTPUT"
            exit 0
        fi
        git commit -q -m "Squash of #$PR"
        tree=$(git rev-parse 'HEAD^{tree}')
        echo "tree=$tree" >>"$GITHUB_OUTPUT"
        if [[ "$tree" == "$CHECKED_TREE" ]]; then
            echo "▸ The review run checked this exact tree; no need to check again."
            echo "state=verified" >>"$GITHUB_OUTPUT"
        else
            echo "▸ Main moved since the review run's check; checking #$PR squashed onto ${main:0:7}."
            echo "state=unverified" >>"$GITHUB_OUTPUT"
        fi
        ;;
    check)
        if [[ "$HAS_SDK_KEY" == true ]]; then check=(scripts/check); else check=(scripts/check --lint); fi
        for attempt in 1 2; do
            if "${check[@]}"; then
                echo "state=verified" >>"$GITHUB_OUTPUT"
                exit 0
            fi
            echo "::warning::scripts/check failed on attempt $attempt."
        done
        echo "state=failed" >>"$GITHUB_OUTPUT"
        ;;
    *)
        echo "usage: verify squash|check" >&2
        exit 2
        ;;
esac
