      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עד"
          }
        }
      }
    },
    "When it goes. It goes now when no time is chosen." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתי היא נשלחת. היא נשלחת עכשיו כשלא נבחר זמן."
          }
        }
      }
    },
    "Who a forward goes to, or more people for a reply." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למי ההעברה נשלחת, או אנשים נוספים לתשובה."
          }
        }
      }
    }
  },
  "version" : "1.0"
