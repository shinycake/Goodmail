    },
    "Starred" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסומן בכוכב"
          }
        }
      }
    },
    "Stars or unstars conversations." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסמן או מבטל סימון כוכב בשיחות."
          }
        }
      }
    },
