      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סמן שיחות כנקראו"
          }
        }
      }
    },
    "Marks conversations read or unread." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מסמן שיחות כנקראו או כלא נקראו."
