    },
    "Sends an email from one of your accounts without opening Goodmail, now or at the time you choose." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שולח אימייל מאחד החשבונות שלך בלי לפתוח את Goodmail, עכשיו או בזמן שתבחר."
          }
        }
      }
    },
    "Show and alert only for the chosen accounts." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצגה והתראות רק עבור החשבונות שנבחרו."
          }
        }
      }
    },
    "Snooze ${threads} for ${duration}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נדנד את ${threads} למשך ${duration}"
