    "Moves conversations to Spam, or with Spam off takes them back to the Inbox." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר שיחות לספאם, או כשספאם כבוי מחזיר אותן לדואר הנכנס."
          }
        }
      }
    },
    "Moves conversations to a mailbox, label or folder, out of the one they're in." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מעביר שיחות לתיבת דואר, לתווית או לתיקייה, מתוך המקום שבו הן נמצאות."
