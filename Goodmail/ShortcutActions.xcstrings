          "stringUnit" : {
            "state" : "translated",
            "value" : "מאת"
          }
        }
      }
    },
    "Keeps conversations at the top of their lists, or lets them go." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משאיר שיחות בראש הרשימות שלהן, או משחרר אותן."
          }
        }
      }
    },
    "Keeps replies to conversations out of the Inbox, or lets them in." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מונע מתשובות לשיחות להגיע לדואר הנכנס, או מאפשר להן."
          }
        }
      }
    },
    "Label" : {
