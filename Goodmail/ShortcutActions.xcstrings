    "Delete Conversations Forever" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחק שיחות לצמיתות"
          }
        }
      }
    },
    "Delete Forever" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחק לצמיתות"
          }
        }
      }
    },
    "Delete these conversations' messages in Trash forever? This can't be undone." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למחוק לצמיתות את ההודעות של השיחות האלה שבאשפה? אי אפשר לבטל את זה."
          }
        }
      }
    },
    "Deletes the messages of conversations that are in Trash for good. Messages anywhere else stay." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק לצמיתות את ההודעות של שיחות שבאשפה. הודעות בכל מקום אחר נשארות."
          }
        }
      }
    },
