    },
    "Leaves the mailing list a message came from. Returns the list's page when it has to be finished there." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עוזב את רשימת התפוצה שממנה הגיעה הודעה. מחזיר את דף הרשימה כשצריך לסיים שם."
          }
        }
      }
    },
