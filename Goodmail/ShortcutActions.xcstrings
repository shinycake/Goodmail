      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הסר"
          }
        }
      }
    },
    "Replies to a message, to its sender or to everyone on it, or forwards it. Sends the answer, or opens it in the composer." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משיב להודעה, לשולח או לכל מי שבה, או מעביר אותה. שולח את התשובה, או פותח אותה בחלון הכתיבה."
          }
        }
      }
    },
    "Reply" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השב"
          }
        }
      }
    },
    "Reply All" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השב לכולם"
