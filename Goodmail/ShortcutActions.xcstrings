      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נושא"
          }
        }
      }
    },
    "Takes conversations out of the Inbox for a while, then brings them back to its top, unread." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוציא שיחות מהדואר הנכנס לזמן מה, ואז מחזיר אותן לראשו כלא נקראו."
          }
        }
      }
    },
    "Takes conversations out of the Inbox until a date, then brings them back to its top, unread." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוציא שיחות מהדואר הנכנס עד תאריך, ואז מחזיר אותן לראשו כלא נקראו."
          }
        }
      }
    },
    "Takes conversations out of the Inbox." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוציא שיחות מהדואר הנכנס."
          }
        }
      }
    },
    "The account it goes from. The first account when none is chosen." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החשבון שממנו היא נשלחת. החשבון הראשון כשלא נבחר אף אחד."
          }
        }
      }
    },
