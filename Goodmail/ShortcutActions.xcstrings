      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השב להודעה"
          }
        }
      }
    },
    "Report Spam" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
