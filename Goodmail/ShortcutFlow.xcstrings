      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הודעות"
          }
        }
      }
    },
    "Move ${threads} out of Spam" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוצא את ${threads} מספאם"
          }
        }
      }
    },
    "Mute ${threads}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השתק את ${threads}"
          }
        }
      }
    },
    "Name" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם"
          }
        }
      }
    },
    "No conversation is open in Goodmail." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין שיחה פתוחה ב־Goodmail."
          }
        }
      }
    },
    "Pin ${threads}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצמד את ${threads}"
          }
        }
      }
    },
    "Report ${threads} as spam" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "דווח על ${threads} כספאם"
          }
        }
      }
    },
    "Sender" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שולח"
          }
        }
      }
    },
    "Star ${threads}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סמן את ${threads} בכוכב"
          }
        }
      }
    },
    "Turn off for an automation that runs on its own, so it doesn't wait for an answer." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לכבות באוטומציה שרצה לבד, כדי שהיא לא תחכה לתשובה."
          }
        }
      }
    },
    "Unmute ${threads}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטל השתקה של ${threads}"
          }
        }
      }
    },
    "Unpin ${threads}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטל הצמדה של ${threads}"
          }
        }
      }
    },
    "Unstar ${threads}" : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בטל סימון כוכב של ${threads}"
          }
        }
      }
    }
  },
  "version" : "1.0"
